# Server
PORT=7000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# JWT
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=https://your-frontend-url.com

# File Upload
MAX_FILE_SIZE=10485760 # 10MB
UPLOAD_PATH=./uploads

# SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp_user>
SMTP_PASS=<smtp_password>

# Payment gateways (store secrets securely in deployment env)
PAYSTACK_SECRET_KEY=<paystack_secret>
FLUTTERWAVE_SECRET_KEY=<flutterwave_secret>

# Other provider keys
# Do NOT commit real API keys or secrets to repo. Use your deployment provider's secrets manager.
